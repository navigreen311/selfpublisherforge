# =============================================================================
# SelfPublisherForge -- Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file. It is listed in .gitignore.
#
# Legend:
#   [REQUIRED]  -- Must be set for the app to start correctly
#   [REQUIRED*] -- Must be set with real values in production (placeholder check)
#   [RECOMMENDED] -- Empty default works in dev, but should be set in production
#   [OPTIONAL]  -- Powers optional features; safe to leave empty
# =============================================================================


# -----------------------------------------------------------------------------
# Application  [REQUIRED]
# -----------------------------------------------------------------------------
# General application settings. Set DEBUG=false in staging/production.
APP_NAME=SelfPublisherForge
APP_VERSION=0.1.0
DEBUG=true

# Environment mode: "development", "staging", or "production"
# In production mode, placeholder secrets are rejected at startup.
ENVIRONMENT=development

# API route prefix for all v1 endpoints
API_V1_PREFIX=/api/v1

# Frontend URL used for billing redirects, email links, and CORS origin
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Authentication & Security  [REQUIRED*]
# -----------------------------------------------------------------------------
# SECRET_KEY is used to sign JWT tokens. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string

# JWT token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# Database (PostgreSQL)  [REQUIRED]
# -----------------------------------------------------------------------------
# Async connection string using the asyncpg driver.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/selfpublisherforge

# Set to true to log all SQL statements (useful for debugging, noisy in production)
DATABASE_ECHO=false


# -----------------------------------------------------------------------------
# Redis  [REQUIRED]
# -----------------------------------------------------------------------------
# Used for caching, rate limiting, WebSocket pub/sub, and session storage.
# Database 0 is for general cache; databases 1 and 2 are reserved for Celery
# (see Celery section below).
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Elasticsearch  [REQUIRED]
# -----------------------------------------------------------------------------
# Full-text search engine for Knowledge Vault and Market Intelligence modules.
# In production, this points to AWS OpenSearch with IAM authentication.
ELASTICSEARCH_URL=http://localhost:9200


# -----------------------------------------------------------------------------
# AI / LLM API Keys  [REQUIRED*]
# -----------------------------------------------------------------------------
# Anthropic Claude -- primary LLM provider for all AI features.
# Obtain your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI GPT -- fallback LLM provider (used when Claude is unavailable or for
# specific model routing decisions in the LLM orchestration layer).
# Obtain your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Default model used by the LLM orchestration layer for AI writing, editing,
# style cloning, and agent tasks.
DEFAULT_LLM_MODEL=claude-sonnet-4-5-20250929

# Multiplier applied to AI-generated word counts for estimation purposes.
# Range: 0.1 - 1.0 (lower = more conservative estimates)
AI_WORD_COUNT_MULTIPLIER=0.5


# -----------------------------------------------------------------------------
# AWS / Cloud Storage  [REQUIRED*]
# -----------------------------------------------------------------------------
# S3 (or Cloudflare R2) credentials for file storage: covers, manuscripts,
# exports, and user uploads. Create an IAM user with S3 read/write access
# or use R2 with S3-compatible API.
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE

# S3 bucket name and region for all stored assets
S3_BUCKET=selfpublisherforge-assets
S3_REGION=us-east-1


# -----------------------------------------------------------------------------
# Stripe (Payments & Billing)  [REQUIRED*]
# -----------------------------------------------------------------------------
# Secret key -- server-side only, never expose to the frontend.
# Obtain your keys at: https://dashboard.stripe.com/apikeys
# Use keys starting with sk_test_ for development, sk_live_ for production.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

# Webhook signing secret -- used to verify incoming Stripe webhook payloads.
# Found at: https://dashboard.stripe.com/webhooks (select your endpoint)
# For local dev, use the Stripe CLI: stripe listen --forward-to localhost:8000/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Stripe Price IDs for each subscription tier.  [RECOMMENDED]
# Create products at https://dashboard.stripe.com/products
# Each product's Price ID looks like: price_XXXXXXXXXXXXX
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXXX
STRIPE_PRICE_PRO=price_XXXXXXXXXXXXX
STRIPE_PRICE_BUSINESS=price_XXXXXXXXXXXXX
STRIPE_PRICE_ENTERPRISE=price_XXXXXXXXXXXXX


# -----------------------------------------------------------------------------
# Email -- SendGrid (Primary)  [REQUIRED*]
# -----------------------------------------------------------------------------
# API key for transactional email delivery (password resets, notifications,
# ARC invitations, marketing campaigns).
# Obtain your key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE

# "From" address used on all outgoing emails via SendGrid
FROM_EMAIL=noreply@selfpublisherforge.com


# -----------------------------------------------------------------------------
# Email -- SMTP (Fallback / Alternative)  [OPTIONAL]
# -----------------------------------------------------------------------------
# SMTP configuration is used as a fallback when SendGrid is unavailable,
# or as the primary transport if you prefer direct SMTP delivery.
# Leave these unset to use SendGrid only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@selfpublisherforge.com


# -----------------------------------------------------------------------------
# Celery (Background Task Processing)  [REQUIRED]
# -----------------------------------------------------------------------------
# Broker URL -- Redis database 1 (separate from the cache on database 0)
CELERY_BROKER_URL=redis://localhost:6379/1

# Result backend -- Redis database 2 (stores task return values and status)
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# -----------------------------------------------------------------------------
# OAuth Providers (Social Login)  [OPTIONAL]
# -----------------------------------------------------------------------------
# OAuth is OPTIONAL -- email/password authentication works without any OAuth
# configuration. Enable one or both providers below to allow social login.
# See docs/guides/oauth-setup.md for detailed setup instructions.
#
# NOTE: When OAuth credentials are left empty, the corresponding "Sign in
# with <Provider>" button should be hidden in the frontend. The backend
# returns HTTP 501 if a user tries to initiate an unconfigured OAuth flow.

# --- Google OAuth 2.0 ("Sign in with Google") ---
#
# Where to get these values:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (Web application type)
#   3. Copy the Client ID and Client Secret from the credential details page
#
# GOOGLE_CLIENT_ID    -- The OAuth 2.0 client ID (looks like: 123456789-abc.apps.googleusercontent.com)
# GOOGLE_CLIENT_SECRET -- The OAuth 2.0 client secret
# GOOGLE_REDIRECT_URI  -- Must match an "Authorized redirect URI" in the Google console.
#                         For local dev:  http://localhost:3000/auth/google/callback
#                         For production: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- GitHub OAuth ("Sign in with GitHub") ---
#
# Where to get these values:
#   1. Go to https://github.com/settings/developers (or your org's Developer settings)
#   2. Click "New OAuth App" (or "Register a new application")
#   3. Copy the Client ID and generate a Client Secret on the app's settings page
#
# GITHUB_CLIENT_ID     -- The OAuth App client ID
# GITHUB_CLIENT_SECRET  -- The OAuth App client secret (shown once at creation; regenerate if lost)
# GITHUB_REDIRECT_URI   -- Must match the "Authorization callback URL" in GitHub settings.
#                          For local dev:  http://localhost:3000/auth/github/callback
#                          For production: https://your-domain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback


# -----------------------------------------------------------------------------
# Amazon Ads  [RECOMMENDED]
# -----------------------------------------------------------------------------
# Amazon Advertising API credentials for managing book ad campaigns.
# Register at: https://advertising.amazon.com/API
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=

# Amazon Ads marketplace region: NA (North America), EU (Europe), FE (Far East)
AMAZON_ADS_REGION=NA

# Default bid amount (USD) for new Amazon Ads campaigns
DEFAULT_BID_AMOUNT=0.75


# -----------------------------------------------------------------------------
# Facebook Ads  [OPTIONAL]
# -----------------------------------------------------------------------------
# Facebook Marketing API version used for ad campaign management.
# See supported versions: https://developers.facebook.com/docs/graph-api/changelog
FACEBOOK_ADS_API_VERSION=v18.0


# -----------------------------------------------------------------------------
# Chrome Extension  [OPTIONAL]
# -----------------------------------------------------------------------------
# Chrome Extension ID for browser extension authentication and messaging.
# Found in chrome://extensions after loading the unpacked extension.
CHROME_EXTENSION_ID=


# -----------------------------------------------------------------------------
# Market Intelligence  [OPTIONAL]
# -----------------------------------------------------------------------------
# Sigmoid scoring midpoints for market intelligence analysis.
# These control how raw metrics are normalized into 0-100 scores.

# Demand midpoint: search volume threshold for 50% score
MI_DEMAND_MIDPOINT=5000

# Competition midpoint: number of competing titles for 50% score
MI_COMPETITION_MIDPOINT=50000

# Opportunity midpoint: opportunity index threshold for 50% score
MI_OPPORTUNITY_MIDPOINT=500


# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)  [REQUIRED]
# -----------------------------------------------------------------------------
# Allowed origins for API requests. In production, set this to your frontend
# domain(s). Accepts a JSON array of strings.
# Note: FRONTEND_URL is automatically appended to this list at startup.
CORS_ORIGINS=["http://localhost:3000"]


# -----------------------------------------------------------------------------
# Publishing Platform APIs  [OPTIONAL]
# -----------------------------------------------------------------------------
# Amazon KDP (Kindle Direct Publishing) reporting API credentials.
# Used by the Publishing Operations and Revenue Tracking modules.
KDP_ACCESS_KEY=
KDP_SECRET_KEY=
KDP_API_BASE_URL=https://kdp.amazon.com/api/reports/v1

# IngramSpark API -- for print-on-demand distribution management.
INGRAM_SPARK_API_KEY=
INGRAM_SPARK_API_SECRET=

# Draft2Digital API -- for wide ebook distribution.
D2D_API_KEY=
