# Load Testing Configuration
# Copy this file to .env and update with your values

# Backend API URL
# For local testing: http://localhost:8000
# For Docker: http://host.docker.internal:8000
BACKEND_URL=http://localhost:8000

# Load profile to use (smoke, normal, stress, spike, soak)
LOAD_PROFILE=smoke

# Test user credentials
# Create this user in your backend before running load tests
# IMPORTANT: Disable MFA for this user
LOAD_TEST_USER_EMAIL=loadtest@example.com
LOAD_TEST_USER_PASSWORD=LoadTest123!
