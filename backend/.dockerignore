# Local virtualenvs — `COPY . .` otherwise ships a developer's entire venv into
# the image, Windows binaries and all, and the image scanner then reports the
# packages inside it as if they were the application's.
.venv/
venv/
env/

# Python build/run artefacts
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
junit.xml

# Not needed to run the service
tests/
.env
.env.*
!.env.example
