# =============================================================================
# Production Environment Variables for docker-compose.prod.yml
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
#
#   cp .env.prod.example .env
#
# Variables marked [REQUIRED] will cause docker compose to abort if unset.
# Variables marked [OPTIONAL] have sensible defaults shown after the ":-".
# =============================================================================

# ---------------------------------------------------------------------------
# Application Secret Key  [REQUIRED]
# ---------------------------------------------------------------------------
# Used for signing tokens, cookies, and other cryptographic operations.
# Generate a strong random value, e.g.:  openssl rand -hex 64
SECRET_KEY=change-me-to-a-random-secret

# ---------------------------------------------------------------------------
# PostgreSQL  [REQUIRED / OPTIONAL]
# ---------------------------------------------------------------------------
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me-to-a-strong-password
# POSTGRES_DB is optional; defaults to "selfpublisherforge" if omitted
POSTGRES_DB=selfpublisherforge

# ---------------------------------------------------------------------------
# Elasticsearch  [REQUIRED]
# ---------------------------------------------------------------------------
# Password for the built-in "elastic" superuser.
# Generate a strong random value, e.g.:  openssl rand -hex 32
ELASTIC_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# AWS Credentials  [OPTIONAL — required if using S3 storage]
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION defaults to us-east-1 if omitted
AWS_REGION=us-east-1
S3_BUCKET_NAME=
